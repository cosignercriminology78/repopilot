FROM node:22-bookworm-slim AS build
WORKDIR /opt/repopilot
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /opt/repopilot
COPY --from=build /opt/repopilot/package.json ./
COPY --from=build /opt/repopilot/node_modules ./node_modules
COPY --from=build /opt/repopilot/dist ./dist
USER 65534:65534
ENTRYPOINT ["node", "/opt/repopilot/dist/agent-entry.js"]
