{
  "repository": "OWNER/REPOSITORY",
  "dataDir": ".repopilot-data",
  "pollSeconds": 60,
  "freshnessSeconds": 15,
  "taskTimeoutSeconds": 1800,
  "runner": {
    "image": "node:22-bookworm-slim",
    "command": [
      "node",
      "--test"
    ],
    "reporter": "node",
    "timeoutSeconds": 300,
    "memory": "1g",
    "cpus": 2
  },
  "agent": {
    "enabled": false,
    "repair": false,
    "image": "repopilot-agent:local",
    "timeoutSeconds": 300,
    "maxAttempts": 2,
    "maxCalls": 16,
    "maxTokens": 200000
  },
  "retry": {
    "attempts": 3,
    "baseDelayMs": 1000,
    "maxDelayMs": 30000,
    "maxTaskExecutions": 3
  },
  "publish": false
}
